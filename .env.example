# ==============================================================================
# BALLOTBUDDY AI: MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS: 
# 1. Fill in the values below.
# 2. Place this file in the PROJECT ROOT directory.
# 3. For Docker: docker-compose will automatically pass these to the containers.
# ==============================================================================

# --- GOOGLE CLOUD & GEMINI CONFIG ---
GEMINI_API_KEY=your_gemini_api_key_here
FIRESTORE_PROJECT_ID=your_gcp_project_id_here
GCP_LOCATION=asia-south1

# Path inside the container for the service account JSON
# (Ensure your key is named 'service-account.json' and placed in the backend/ folder)
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# --- FIREBASE CONFIG (FRONTEND & AUTH) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- GOOGLE MAPS CONFIG ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- INFRASTRUCTURE CONFIG ---
# Use 'redis://redis:6379/0' when running in Docker
# Use 'redis://localhost:6379/0' when running locally outside Docker
REDIS_URL=redis://redis:6379/0

# Generate a secure secret key (e.g., openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_hex_here

# --- API & CORS CONFIG ---
PROJECT_NAME="BallotBuddy AI"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
