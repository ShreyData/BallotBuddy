# Infrastructure Config
# Use 'redis://redis:6379/0' when running in Docker
# Use 'redis://localhost:6379/0' when running locally outside Docker
REDIS_URL=redis://redis:6379/0

# Generate a secure secret key (e.g., openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_hex_here

# API Config
PROJECT_NAME="BallotBuddy AI"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=8000
